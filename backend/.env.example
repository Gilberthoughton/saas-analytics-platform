# Application
PROJECT_NAME="SaaS Analytics Platform"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"

# Security — generate with: openssl rand -hex 32
SECRET_KEY="change-me-to-a-long-random-string"
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM="HS256"

# Database (PostgreSQL in dev/prod; the test suite overrides this with SQLite)
DATABASE_URL="postgresql+psycopg2://analytics:YOUR_URL_ENCODED_PASSWORD@localhost:5432/analytics"

# Cache (set CACHE_BACKEND=memory to disable Redis, e.g. for tests)
REDIS_URL="redis://localhost:6379/0"
CACHE_BACKEND="redis"
ANALYTICS_CACHE_TTL_SECONDS=30

# CORS (comma-separated browser origins)
BACKEND_CORS_ORIGINS="http://localhost:3000"
